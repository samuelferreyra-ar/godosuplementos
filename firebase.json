{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "//": "Rediseño publicado con carrito por WhatsApp. La raíz conserva el sitio anterior como referencia.",
    "public": "web",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "tools/**",
      "**/*.zip",
      "README.md"
    ],
    "redirects": [
      { "source": "/comprar.html", "destination": "/carrito.html", "type": 302 },
      { "source": "/checkout.html", "destination": "/carrito.html", "type": 302 },
      { "source": "/proteina.html", "destination": "/proteinas.html", "type": 301 },
      { "source": "/proteina1.html", "destination": "/proteinas.html", "type": 301 },
      { "source": "/mis-datos.html", "destination": "/mi-cuenta.html", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "/api/crearPedido",
        "function": {
          "functionId": "crearPedido",
          "region": "southamerica-west1"
        }
      },
      {
        "source": "/api/cancelarPedido",
        "function": {
          "functionId": "cancelarPedido",
          "region": "southamerica-west1"
        }
      },
      {
        "source": "/api/validarCupon",
        "function": {
          "functionId": "validarCupon",
          "region": "southamerica-west1"
        }
      },
      {
        "source": "/api/generarCupones",
        "function": {
          "functionId": "generarCupones",
          "region": "southamerica-west1"
        }
      }
    ],
    "headers": [
      {
        "//": "Regla base: nada se cachea sin revalidar. Cubre la raiz y las rutas sin extension, que no matchean un patron por tipo de archivo.",
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "//": "Las imagenes si se cachean: gana la ultima regla que matchea.",
        "source": "**/*.@(webp|png|jpg|jpeg|avif|gif|svg|ico|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
